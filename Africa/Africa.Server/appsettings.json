{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": []
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "Cleanup": {
    "Enabled": true,
    "MaxAgeHours": 12,
    "IntervalHours": 12
  },
  "RateLimiting": {
    "Applications": {
      "PermitLimit": 5,
      "WindowMinutes": 10
    }
  }
}
